{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=optional",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
  "source": "/api/:path*",
  "destination": "https://rafiqjewellery-1kpj-egosdgwb2.vercel.app/api/:path*"
},
    { "source": "/((?!api/|assets/|fonts/|downloads/|.*\\.).*)", "destination": "/index.html" }
  ]
}
